# Copy to .env (optional). Everything works with no .env at all.

# --- Optional AI assist (document field extraction fallback + email greeting) ---
# Set ONE of these. If both are set, OpenAI is used unless VO_LLM_PROVIDER says otherwise.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-haiku-latest
# VO_LLM_PROVIDER=auto        # auto | openai | anthropic | none
# VO_LLM_TIMEOUT_SECONDS=20

# --- Demo pacing: pause between stages so the live view is watchable ---
# VO_STAGE_DELAY_SECONDS=0.6

# --- Policy thresholds ---
# VO_REVIEW_RISK_THRESHOLD=30
# VO_BANK_LETTER_MAX_AGE_DAYS=90
# VO_SANCTIONS_REVIEW_SCORE=85
# VO_SANCTIONS_BLOCK_SCORE=95
# VO_MAX_UPLOAD_MB=5

# --- Links and branding in emails ---
# VO_PUBLIC_BASE_URL=http://localhost:8000
# VO_BUYER_COMPANY=Acme Buyer Pvt Ltd
# VO_PROCUREMENT_EMAIL=procurement@acme-buyer.example
# VO_REVIEW_TEAM_EMAIL=vendor-risk@acme-buyer.example
